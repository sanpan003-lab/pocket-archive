# Copy to .env and adjust the path for your machine
PORT=3001
# Random secret for login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ARCHIVE_PATH=H:\My Drive\Hey Pocket Archive

# Claude — AI notes and Quick Capture classification
CLAUDE_API_KEY=your-anthropic-key-here
CLAUDE_MODEL=claude-sonnet-5-5

# Gemini — Quick Capture transcription (and "Regenerate with Gemini")
GEMINI_API_KEY=your-gemini-key-here
# Optional: transcription model and the fallback used when it's busy
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Google Calendar sync for Quick Capture (optional — see docs/google-calendar-setup.md)
# Path to the service account JSON key. Keep it OUT of the repo, e.g. in the
# NAS config folder that is mounted at /data/config.
GOOGLE_SERVICE_ACCOUNT_FILE=/data/config/google-service-account.json
# The calendar to write to — usually your Gmail address. That calendar must be
# shared with the service account email with "Make changes to events".
GOOGLE_CALENDAR_ID=you@gmail.com
