<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1: the Neon Bolt in a dark circle (tap = record); while recording a red ring, the time and Stop -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:contentDescription="Start Quick Capture">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:src="@drawable/widget_bg_bolt"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_bolt_neon"
        android:importantForAccessibility="no" />

    <Chronometer
        android:id="@+id/widget_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:background="@drawable/widget_badge"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/widget_progress"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="#FFA78BFA"
        android:visibility="gone" />
</FrameLayout>
