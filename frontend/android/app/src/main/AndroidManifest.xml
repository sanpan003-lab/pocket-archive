<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Errand arrival reminders: geofences around stores; location stays on the phone -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- Open straight into recording / the inbox (app shortcuts, automations) -->
            <intent-filter>
                <action android:name="com.sanpan003.pocketarchive.START_RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.sanpan003.pocketarchive.OPEN_INBOX" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- App icon (Settings → App icon): one launcher entry per tile, exactly one enabled
             (quick/AppIcon.kt). Dark is the default. The Quick Record / Stop Recording entries
             follow the same tile; the Dark ones keep their original names so a side key or
             Routine set up before still works. -->
        <activity-alias
            android:name=".AppIconDark"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconLight"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_light"
            android:roundIcon="@mipmap/ic_launcher_round_light"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".AppIconAmoled"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_amoled"
            android:roundIcon="@mipmap/ic_launcher_round_amoled"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Second launcher entry "Quick Record": opens the app and starts recording.
             Pick it for the Samsung side key ("Double press → Open app"). -->
        <activity-alias
            android:name=".QuickRecordLauncher"
            android:targetActivity=".MainActivity"
            android:label="@string/quick_record_label"
            android:icon="@mipmap/ic_quick_record"
            android:roundIcon="@mipmap/ic_quick_record"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".QuickRecordLauncherLight"
            android:targetActivity=".MainActivity"
            android:label="@string/quick_record_label"
            android:icon="@mipmap/ic_quick_record_light"
            android:roundIcon="@mipmap/ic_quick_record_light"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".QuickRecordLauncherAmoled"
            android:targetActivity=".MainActivity"
            android:label="@string/quick_record_label"
            android:icon="@mipmap/ic_quick_record_amoled"
            android:roundIcon="@mipmap/ic_quick_record_amoled"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Third launcher entry "Stop Recording": no UI. Stops & uploads if recording, does nothing
             otherwise (never starts one). Must be a launcher entry so Samsung's side key and
             Routines ("Open app") can pick it; Android has no way to hide those from the drawer. -->
        <activity-alias
            android:name=".StopRecordLauncher"
            android:targetActivity=".quick.RecordTrampolineActivity"
            android:label="@string/stop_record_label"
            android:icon="@mipmap/ic_stop_record"
            android:roundIcon="@mipmap/ic_stop_record"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".StopRecordLauncherLight"
            android:targetActivity=".quick.RecordTrampolineActivity"
            android:label="@string/stop_record_label"
            android:icon="@mipmap/ic_stop_record_light"
            android:roundIcon="@mipmap/ic_stop_record_light"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".StopRecordLauncherAmoled"
            android:targetActivity=".quick.RecordTrampolineActivity"
            android:label="@string/stop_record_label"
            android:icon="@mipmap/ic_stop_record_amoled"
            android:roundIcon="@mipmap/ic_stop_record_amoled"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Invisible: lets the widget and tile start recording without opening the app -->
        <activity
            android:name=".quick.RecordTrampolineActivity"
            android:theme="@style/Theme.Trampoline"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:showWhenLocked="true" />

        <!-- Optional double-press volume shortcuts (off until the user turns it on in Android's Accessibility settings) -->
        <service
            android:name=".quick.VolumeShortcutService"
            android:label="@string/volume_shortcuts_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/volume_shortcuts" />
        </service>

        <receiver android:name=".quick.DiscardUndoReceiver" android:exported="false" />

        <service
            android:name=".quick.QuickRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".quick.QuickToggleWidget"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_info" />
        </receiver>

        <service
            android:name=".quick.QuickCaptureTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_stat_mic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- Galaxy Watch app: recordings, checklist changes, token/sync requests -->
        <service
            android:name=".quick.WearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/pa/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/pocket_archive_watch" />
            </intent-filter>
        </service>

        <!-- Errands: geofence transitions, notification actions, re-arm after reboot/update -->
        <receiver
            android:name=".quick.GeofenceReceiver"
            android:exported="false" />
        <!-- Fallback: low-power location updates while a location reminder is active -->
        <receiver
            android:name=".quick.LocationFallbackReceiver"
            android:exported="false" />
        <receiver
            android:name=".quick.ErrandActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".quick.QuickActionReceiver"
            android:exported="false" />
        <receiver
            android:name=".quick.ErrandBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.location.PROVIDERS_CHANGED" />
                <action android:name="android.location.MODE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
